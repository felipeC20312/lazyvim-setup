{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // "logo": {
  //   "type": "kitty",
  //   "source": "/Users/felipe/.config/faascii-art.png",
  //   "width": 28,
  //   "height": 12
  // },
  "logo": {
    "type": "file",
    "source": "/Users/felipe/.config/fastfetch/arcii-art.txt"
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m HARDWARE"
    },
    {
      "type": "host",
      "key": "├─PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "├─󰻠 ",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "├─󰍹 ",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "├─󰑭 ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "└─󰋊 ",
      "keyColor": "green"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m SOFTWARE"
    },
    {
      "type": "os",
      "key": "├─OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "├─󰌽 ",
      "keyColor": "yellow"
    },
    {
      "type": "bios",
      "key": "├─󰖡 ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "├─󰏗 ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "└─󰞷 ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m SYSTEM"
    },
    {
      "type": "lm",
      "key": "├─󰍁 ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "├─󱂬 ",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "├─󰉦 ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "└─󰆍 ",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m TIME"
    },
    {
      "type": "command",
      "key": "├─OS Age  ",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "├─Uptime  ",
      "keyColor": "magenta"
    },
    {
      "type": "datetime",
      "key": "└─DateTime  ",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m NETWORK"
    },
    {
      "type": "localip",
      "key": "├─Local IP",
      "showFlags": true,
      "compact": true,
      "keyColor": "red"
    },
    {
      "type": "publicip",
      "key": "├─Public IP",
      "timeout": 1000,
      "keyColor": "red"
    },
    {
      "type": "dns",
      "key": "└─DNS",
      "showType": "both",
      "keyColor": "red"
    },
    "break",
    "break",
    {
      "type": "colors",
      "symbol": "block"
    },
    "break"
  ]
}
